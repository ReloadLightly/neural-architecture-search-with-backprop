.venv/
__pycache__/
*.pyc
.pytest_cache/
artifacts/
logs/

# Raw results are ignored by default, but a versioned release is durable
# evidence and is committed. Checkpoints stay out: they are large and are
# reproducible from the release.
results/**
!results/backprop-neat-v1/
!results/backprop-neat-v1/**
!results/backprop-neat-v2/
!results/backprop-neat-v2/**
results/backprop-neat-*/**/checkpoints/
